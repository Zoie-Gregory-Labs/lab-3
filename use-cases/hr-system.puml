@startuml
left to right direction

actor HR as "HR Advisor"
actor DM as "Department Manager"

rectangle Database

rectangle "HR System" {
  usecase UC1 as "Produce salary report for all employees"
  usecase UC2 as "Produce salary report by department"
  usecase UC3 as "Produce salary report for own department"
  usecase UC4 as "Produce salary report by role"
  usecase UC5 as "Add employee details"
  usecase UC6 as "View employee details"
  usecase UC7 as "Update employee details"
  usecase UC8 as "Delete employee details"
  usecase PRINT as "Print / Export report"

  HR -- UC1
  HR -- UC2
  DM -- UC3
  HR -- UC4
  HR -- UC5
  HR -- UC6
  HR -- UC7
  HR -- UC8

  UC1 ..> PRINT : include
  UC2 ..> PRINT : include
  UC3 ..> PRINT : include
  UC4 ..> PRINT : include

  UC1 -- Database
  UC2 -- Database
  UC3 -- Database
  UC4 -- Database
  UC5 -- Database
  UC6 -- Database
  UC7 -- Database
  UC8 -- Database
}

@enduml
